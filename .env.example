# Render PostgreSQL 외부 주소 (hw2 스키마를 쓴다)
DATABASE_URL=postgresql://user:password@host.ohio-postgres.render.com/dbname
# 로그인 토큰 서명용 비밀값 (16자 이상)
AUTH_SECRET=
PORT=4000
# 코어 웹, 어드민 주소 (쉼표로 구분)
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001
# db/apply.mjs가 첫 관리자 계정을 만들 때만 쓴다
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=원장
